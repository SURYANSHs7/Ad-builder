# Production URLs of the n8n webhooks (all server-only)
# Go 2 Market v3: POST /webhook/go-2-market-v3 and /webhook/go-2-market-v3-status
N8N_WEBHOOK_URL=
N8N_STATUS_URL=
# Go 2 Market Chat: POST /webhook/g2m-chat, /webhook/g2m-me, /webhook/g2m-email, /webhook/g2m-photo
N8N_CHAT_URL=
N8N_ME_URL=
N8N_EMAIL_URL=
N8N_PHOTO_URL=
# Value of the x-api-key Header Auth credential in n8n
N8N_API_KEY=
