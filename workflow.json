    {
      "id": "67055a28-2663-4270-bddb-ce729e6895e9",
      "name": "Validate input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        320
      ],
      "parameters": {
        "jsCode": "// Validate the request and mint a job id the frontend can poll with.\n// The product photo is stored on the user (g2m-photo) and checked by Progress: spend.\nconst body = $input.first().json.body ?? {};\n\nconst SIZES = { square: '1024x1024', portrait: '1024x1536', landscape: '1536x1024' };\nconst STYLES = {\n  auto: '',\n  'luxe-dark': 'Luxe dark: low-key light, black stone or velvet, dramatic rim light, gold or deep jewel-tone accents.',\n  sunlit: 'Sunlit: warm golden-hour daylight, Mediterranean stone or linen, crisp natural shadows, airy and optimistic.',\n  'minimal-studio': 'Minimal studio: one or two sculptural podiums in a bold colour that complements the product, soft gradient light. A designed set, never a plain white background.',\n  nature: 'Nature: an outdoor natural setting that suits the product (moss, water, sand, leaves or stone), natural light.',\n  neon: 'Neon: dark reflective set with saturated neon accent lighting and a futuristic night-time mood.',\n};\n\nconst uid = String(body.uid ?? '');\nconst title = String(body.title ?? '').trim().slice(0, 80);\nconst description = String(body.description ?? '').trim().slice(0, 600);\nconst aspect = String(body.aspect || 'square');\nconst style = String(body.style || 'auto');\nconst direction = String(body.direction ?? '').trim().slice(0, 300);\n\nlet error = null;\nif (!/^[a-z0-9]{24}$/.test(uid)) error = 'Invalid session.';\nelse if (!title) error = 'Product name is required.';\nelse if (!(aspect in SIZES) || !(style in STYLES)) error = 'Unknown format or style.';\n\nconst chars = 'abcdefghijklmnopqrstuvwxyz0123456789';\nconst jobId = Array.from({ length: 24 }, () => chars[Math.floor(Math.random() * chars.length)]).join('');\n\nreturn [{ json: { ok: !error, status: 400, error, jobId, uid, event: 'spend', title, description, aspect, style, direction, size: SIZES[aspect], styleHint: STYLES[style] ?? '' } }];"
      }
    },
